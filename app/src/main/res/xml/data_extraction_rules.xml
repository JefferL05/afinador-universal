<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules: só as preferências do usuário são incluídas.
     Nada de áudio, porque o app não grava nada. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>