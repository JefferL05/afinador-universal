<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Duas permissões, e só duas. Sem INTERNET: nada de áudio sai do aparelho.

      VIBRATE é normal — não aparece na tela de permissões do Android e o
      usuário não pode negá-la. Sem ela declarada, `Vibrator.vibrate()` lança
      SecurityException e a confirmação tátil do afinador simplesmente nunca
      acontece, sem nenhuma mensagem visível.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- O afinador roda bem em celular; a textura em Tablet é opcional. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".AfinadorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Afinador"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Afinador">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          Compartilha UMA pasta só: as gravações de ideias, em filesDir/ideias.

          Por que existe: a tela de gravação delega a reprodução ao player do
          sistema (o app não tem player próprio). Para o player de outro app
          abrir um arquivo interno é preciso um content:// autorizado — mandar
          um file:// direto lança `FileUriExposedException` no Android 7 ou
          superior, e o toque morria antes de chegar a lugar nenhum.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".widget.TunerWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!--
          Toca a nota de referência do widget. Precisa ser exported porque o
          PendingIntent vem do launcher, que roda em outro processo. O receiver
          não faz nada além de tocar um tom: não lê nem grava nada.
        -->
        <receiver
            android:name=".widget.ReferenceToneReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.afinu.app.PLAY_REFERENCE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>